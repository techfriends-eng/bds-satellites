#!/usr/bin/env bash
# Не даём закоммитить секрет. Включается один раз: git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks не установлен (brew install gitleaks) — коммит остановлен" >&2
  exit 1
fi
gitleaks protect --staged --redact --no-banner
