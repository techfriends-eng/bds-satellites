# /etc/bds-sat-__SITE__.env на progon, права 640 root:bds-sat-__SITE__ (handbook standards/05).
# Пути
SAT_SITE_DIR=/opt/bds-sat-__SITE__
SAT_STATE_DIR=/var/lib/bds-sat-__SITE__
SAT_STAND_BASE=/var/lib/bds-sat-__SITE__/runs
# Node не ругается на экспериментальный node:sqlite в логе прогона
NODE_OPTIONS=--no-warnings=ExperimentalWarning
# OpenRouter: ключ сайта с месячным лимитом (настраивается в OpenRouter)
OPENROUTER_API_KEY=
# Подписка Claude для моделей claude-cli:<alias> (claude setup-token); не нужна, если их нет в site.yaml
#CLAUDE_CODE_OAUTH_TOKEN=
#SAT_CLAUDE_BIN=/usr/local/bin/claude
#DISABLE_AUTOUPDATER=1
# WordPress сайта: логин профиля (не имя пароля приложения) и Application Password (handbook gotchas/wordpress.md)
WP_URL=https://__DOMAIN__
WP_USER=
WP_APP_PASSWORD=
# Журнал BDS Хаба: база sat на auto08, роль sat_writer (pg_hba пускает только progon)
SAT_DB_URL=postgres://sat_writer:<пароль>@<auto08>:5432/sat
# Общий журнал расхода LLM llm.calls на supan8n (bds-content ADR 0001, п. 5). Строку пишет bds-content
# ops/llm_ledger_setup.sh — руками не вписывать. Пусто — журнал выключен, конвейер работает как раньше.
LLM_LEDGER_DB_URL=postgresql://llm_writer.<tenant>:<пароль>@100.78.10.70:5432/postgres
# Сверка со Stack Radar: роль sat_reader, только чтение articles
STACKRADAR_RO_URL=postgres://sat_reader:<пароль>@<auto08>:5432/stackradar
# Индекс документации версий стенда (bds-docs-index на supan8n, ADR 0002) по Tailscale. Пусто — без индекса.
# DOCS_DB_URL — роль docs_reader через пулер Supabase (строка из ~/.config/docs/docs-reader-url.env на wsa100)
DOCS_DB_URL=postgresql://docs_reader.<tenant>:<пароль>@100.78.10.70:5432/postgres
DOCS_OLLAMA_URL=http://100.78.10.70:11434
