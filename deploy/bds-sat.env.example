# Переменные конвейера bds-satellites. Живой файл — /etc/bds-sat-<site>.env на progon (шаблон сайта: site-template/deploy).
# Пути
SAT_SITE_DIR=/opt/bds-sat-<site>
SAT_STATE_DIR=/var/lib/bds-sat-<site>
SAT_STAND_BASE=/var/lib/bds-sat-<site>/runs
# Node не ругается на экспериментальный node:sqlite в логе прогона
NODE_OPTIONS=--no-warnings=ExperimentalWarning
# OpenRouter: ключ сайта с месячным лимитом (настраивается в OpenRouter)
OPENROUTER_API_KEY=
# WordPress сайта: логин профиля (не имя пароля приложения) и Application Password (handbook gotchas/wordpress.md)
WP_URL=https://<site>-school.ru
WP_USER=
WP_APP_PASSWORD=
# Журнал BDS Хаба: база sat на auto08, роль sat_writer (pg_hba пускает только progon)
SAT_DB_URL=postgres://sat_writer:<пароль>@<auto08>:5432/sat
# Сверка со Stack Radar: роль sat_reader, только чтение articles
STACKRADAR_RO_URL=postgres://sat_reader:<пароль>@<auto08>:5432/stackradar
